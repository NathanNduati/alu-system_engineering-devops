#!/usr/bin/env bash
# Configures Nginx with a custom 404 page and redirection

apt-get -y update
apt-get -y install nginx

# Create the root page (from Task 1)
echo "Holberton School" > /var/www/html/index.html

# Create the custom 404 page (Task 4)
echo "Ceci n'est pas une page" > /var/www/html/404.html
echo "Ceci n'est pas une page" > /usr/share/nginx/html/404.html

# Use sed to safely inject the redirect and 404 rules
sed -i 's/server_name _;/server_name _;\n\trewrite ^\/redirect_me https:\/\/www.youtube.com\/watch?v=QH2-TGUlwu4 permanent;\n\terror_page 404 \/404.html;\n\tlocation = \/404.html {\n\t\troot \/var\/www\/html;\n\t\tinternal;\n\t}/' /etc/nginx/sites-available/default

# Restart Nginx
service nginx restart
exit 0
